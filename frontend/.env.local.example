# Use the FastAPI backend running on this machine.
INVOICE_NER_API_URL=http://127.0.0.1:7860

# Keep these empty to route requests to the local backend instead of Runpod.
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=
RUNPOD_INVOKE_BASE_URL=https://api.runpod.ai/v2

# Leave empty for local development without the demo password gate.
DEMO_PASSWORD=

# Optional: processing deadline in milliseconds, clamped to 1000–240000.
INVOICE_PROCESSING_TIMEOUT_MS=240000
