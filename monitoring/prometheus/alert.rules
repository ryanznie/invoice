groups:
  - name: invoice_ner_alerts
    rules:
      - alert: HighErrorRate
        expr: rate(inference_errors_total[5m]) / rate(inference_requests_total[5m]) > 0.01
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "High error rate detected"
          description: "Error rate is above 1% for the last 5 minutes."

      - alert: HighLatency
        expr: histogram_quantile(0.99, rate(inference_latency_seconds_bucket[5m])) > 2.0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High P99 latency detected"
          description: "P99 latency is above 2 seconds for the last 5 minutes."
