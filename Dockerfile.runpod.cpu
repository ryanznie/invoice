FROM python:3.11.13-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEVICE=cpu \
    INFERENCE_BACKEND=onnx \
    MODEL_PATH=/app/models/artifacts/layoutlmv3_invoice_ner.onnx \
    BASE_MODEL=/app/models/artifacts \
    ENABLE_OPENROUTER_FALLBACK=false \
    MAX_IMAGE_BYTES=10485760 \
    MAX_OCR_BYTES=2097152

RUN groupadd --system app && useradd --system --gid app --create-home app

COPY requirements.runpod-cpu.txt ./
RUN pip install --no-cache-dir --requirement requirements.runpod-cpu.txt

COPY src ./src
COPY scripts ./scripts
COPY runpod_handler.py ./
COPY models/artifacts/ ./models/artifacts/

USER app

CMD ["python", "-u", "runpod_handler.py"]
