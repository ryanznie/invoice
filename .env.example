# Invoice NER Application Configuration
# Copy this file to .env and customize as needed

# ============================================================================
# LOGGING
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# MODEL CONFIGURATION
# ============================================================================
# Device to run inference on: cpu, cuda, mps
DEVICE=cpu

# Backend Configuration (onnx or triton)
INFERENCE_BACKEND=onnx

# Triton Configuration
TRITON_URL=localhost:8000

TRITON_MODEL_NAME=layoutlmv3-lora-invoice-number

# Model path (relative to project root)
MODEL_PATH=models/layoutlmv3-lora-invoice-number

# Base model identifier
BASE_MODEL=microsoft/layoutlmv3-base

# Maximum sequence length for model input
MAX_LENGTH=512

# Number of labels (3: O, B-INVOICE_NUMBER, I-INVOICE_NUMBER)
NUM_LABELS=3

# ============================================================================
# OPENROUTER FALLBACK CONFIGURATION
# ============================================================================
# API key for hosted VLM fallback and benchmarks.
# Generate this in OpenRouter and keep the real value only in .env.
OPENROUTER_API_KEY=

# Hosted VLM model ID. Can be swapped for another OpenRouter vision model.
OPENROUTER_MODEL=qwen/qwen2.5-vl-72b-instruct

# OpenRouter OpenAI-compatible endpoint.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Max generated tokens for invoice extraction JSON output.
OPENROUTER_MAX_TOKENS=128

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# Port to run the application on
PORT=7860

# Host to bind to (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
HOST=0.0.0.0

# Enable debug mode (auto-reload on code changes)
DEBUG=false

# ============================================================================
# DOCKER CONFIGURATION
# ============================================================================
# CPU limits (number of cores)
DOCKER_CPU_LIMIT=4
DOCKER_CPU_RESERVATION=2

# Memory limits (in GB)
DOCKER_MEMORY_LIMIT=8G
DOCKER_MEMORY_RESERVATION=4G

# ============================================================================
# PERFORMANCE
# ============================================================================

# Timeout for requests (in seconds)
TIMEOUT=60

# ============================================================================
# PATHS
# ============================================================================
# Data directory for test files
DATA_DIR=./data

# Models directory
MODELS_DIR=./models
